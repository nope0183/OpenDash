+# Генератор растровых GFX-шрифтов (латиница + кириллица) из DejaVu Sans Condensed для TFT_eSPI.
+# Запуск: python3 gen_ru_font.py  ->  src/ru_fonts.h
+from PIL import Image, ImageDraw, ImageFont
+import sys
+TTF = "/usr/share/fonts/truetype/dejavu/DejaVuSansCondensed.ttf"
+FIRST, LAST = 0x20, 0x451
+CODES = list(range(0x20, 0x7F)) + [0x401] + list(range(0x410, 0x450)) + [0x451]
+SIZES = [("RU1", 10), ("RU2", 13), ("RU4", 20)]
+
+def build(size):
+    f = ImageFont.truetype(TTF, size, layout_engine=ImageFont.Layout.BASIC)
+    asc, desc = f.getmetrics()
+    bitmap = bytearray(); glyphs = {}
+    for cp in CODES:
+        ch = chr(cp)
+        adv = int(round(f.getlength(ch)))
+        l, t, r, b = f.getbbox(ch, anchor="ls")
+        w, h = r - l, b - t
+        if ch == " " or w <= 0 or h <= 0:
+            glyphs[cp] = (len(bitmap), 0, 0, adv, 0, 0); continue
+        img = Image.new("L", (w, h), 0)
+        d = ImageDraw.Draw(img); d.fontmode = "1"
+        d.text((-l, -t), ch, font=f, fill=255, anchor="ls")
+        px = [1 if img.getpixel((x, y)) > 127 else 0 for y in range(h) for x in range(w)]
+        off = len(bitmap)
+        for i in range(0, len(px), 8):
+            byte = 0
+            for k in range(8):
+                byte = (byte << 1) | (px[i + k] if i + k < len(px) else 0)
+            bitmap.append(byte)
+        glyphs[cp] = (off, w, h, adv, l, t)
+    return bitmap, glyphs, asc + desc
+
+def emit(out, name, size):
+    bitmap, glyphs, yadv = build(size)
+    out.append(f"// {name}: DejaVu Sans Condensed {size}px, 1-bit")
+    out.append(f"static const uint8_t {name}_bmp[] PROGMEM = {{")
+    for i in range(0, len(bitmap), 16):
+        out.append("  " + ",".join(f"0x{b:02X}" for b in bitmap[i:i+16]) + ",")
+    out.append("};")
+    out.append(f"static const GFXglyph {name}_glyph[] PROGMEM = {{")
+    for cp in range(FIRST, LAST + 1):
+        g = glyphs.get(cp, (0, 0, 0, 0, 0, 0))
+        out.append(f"  {{{g[0]},{g[1]},{g[2]},{g[3]},{g[4]},{g[5]}}},")
+    out.append("};")
+    out.append(f"static const GFXfont {name} PROGMEM = {{(uint8_t*){name}_bmp,(GFXglyph*){name}_glyph,0x{FIRST:02X},0x{LAST:03X},{yadv}}};\n")
+    return bitmap, glyphs
+
+out = ["// Сгенерировано tools/gen_ru_font.py. Не править вручную.",
+       "// Шрифты: латиница + кириллица (Ё, А-я, ё) для TFT_eSPI (формат GFX). Исходник: DejaVu Sans (Bitstream Vera licence).",
+       "#pragma once", "#include <TFT_eSPI.h>", ""]
+data = {}
+for n, s in SIZES:
+    data[n] = emit(out, n, s)
+open(sys.argv[1] if len(sys.argv) > 1 else "src/ru_fonts.h", "w").write("\n".join(out))
+
+print("bytes:", {n: len(data[n][0]) for n, _ in SIZES})
